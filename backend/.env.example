# Postgres. DATABASE_URL is the pooled connection used at runtime; DIRECT_URL is
# the unpooled one, required by `prisma migrate` — migrations must not go through
# the pooler. On Neon the only difference is `-pooler` in the hostname.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15"
# REQUIRED in production — the server refuses to start if either is missing,
# under 32 characters, or still one of these example values. They are public,
# so a token signed with one can be forged by anyone, admin tokens included.
# Generate with: openssl rand -hex 32
JWT_SECRET="your_super_secret_jwt_key_change_in_production_min_32_chars"
JWT_REFRESH_SECRET="your_refresh_secret_key_change_in_production"
PORT=5000
NODE_ENV=development

# UNUSED — there is no Stripe code in the backend; payments go through
# Razorpay. Kept only so existing .env files do not look incomplete.
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Required for checkout. Without them, payment creation and verification fail.
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
# REQUIRED in production — the server refuses to start without these when
# NODE_ENV=production. Hosts give the app an ephemeral filesystem, so uploads
# written to local disk are lost on the next restart. Left unset locally,
# uploads fall back to ./uploads.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
FRONTEND_URL="http://localhost:3000"
# Public address of THIS server. Baked into uploaded-image URLs stored in the
# database, so getting it wrong makes those images permanently unreachable.
BACKEND_URL="http://localhost:5000"
# Email delivery. Brevo is tried first and sends over HTTPS, which works on
# hosts that block outbound SMTP — Render's free plan blocks ports 25, 465 and
# 587, so Gmail SMTP cannot connect there at all.
# EMAIL_FROM must be a sender address verified in your Brevo account.
BREVO_API_KEY="your_brevo_api_key"
EMAIL_FROM="your_verified_sender@example.com"
EMAIL_FROM_NAME="HairsUp"

# Optional. Each disables only its own feature when unset — the server still
# starts. Google: "Sign in with Google". Gmail: fallback email transport, only
# usable where outbound SMTP is permitted. Twilio: WhatsApp order notifications.
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GMAIL_USER="your_gmail_address@gmail.com"
GMAIL_APP_PASSWORD="your_16_char_gmail_app_password"
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
