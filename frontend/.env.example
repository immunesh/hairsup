NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# Only needed by app/api/categories/route.ts, which queries Postgres directly
# via lib/prisma.ts instead of going through the backend. Same values as the
# backend. Drop both once that route is folded into the backend API.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15"
